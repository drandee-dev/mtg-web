# Copy this file to `.env` and fill in values for local development.

# Base URL of the FastAPI analysis backend.
VITE_API_BASE=http://127.0.0.1:8000

# Supabase (optional). Leave BLANK to run in local-only mode (decks save to this
# browser via localStorage, with Export/Import to move them). Fill both in to enable
# cross-device accounts (email magic-link sign-in + synced decks).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Formspree form ID for the feedback button (optional). Get one at formspree.io.
VITE_FORMSPREE_ID=
